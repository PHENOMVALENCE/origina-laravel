  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "POST /tokens with a verified active account, then enter the returned token."
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "division": {
            "type": "string",
            "enum": [
              "b-melanox",
              "bettyworld",
              "bvalence",
              "divine",
              "novia",
              "skin-safari"
            ]
          },
          "description": {
            "type": "string"
          },
          "ingredients": {
            "type": "string",
            "nullable": true
          },
          "usage": {
            "type": "string",
            "nullable": true
          },
          "evidence_note": {
            "type": "string",
            "nullable": true
          },
          "image_path": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "description": "Whole Tanzanian shillings"
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "description": "Available, unreserved units"
          },
          "published": {
            "type": "boolean"
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "division": {
            "type": "string",
            "enum": [
