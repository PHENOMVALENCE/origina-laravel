          },
          "ingredients": {
            "type": "string",
            "nullable": true
          },
          "usage": {
            "type": "string",
            "nullable": true
          },
          "evidence_note": {
            "type": "string",
            "nullable": true
          },
          "image_path": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "description": "Whole Tanzanian shillings"
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "description": "Available, unreserved units"
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "slug",
          "sku",
          "division",
          "description",
          "price",
          "stock",
          "published"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone",
          "address",
          "city"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unit_price": {
            "type": "integer"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "number": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "processing",
              "shipped",
              "delivered",
              "cancelled"
            ]
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "unpaid",
              "paid"
            ]
          },
          "subtotal": {
            "type": "integer"
          },
          "shipping_fee": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "TZS"
            ]
          },
          "shipping_address": {
            "$ref": "#/components/schemas/Address"
          },
          "tracking_reference": {
            "type": "string",
            "nullable": true
          },
          "payment_reference": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "admin"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "email_verified_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CheckoutInput": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "integer"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                }
              },
              "required": [
                "product_id",
                "quantity"
              ]
            }
          },
          "shipping_address": {
            "$ref": "#/components/schemas/Address"
          },
          "checkout_key": {
            "type": "string",
            "format": "uuid",
            "description": "Generate a fresh UUID for each new purchase. Reuse only when retrying the same order."
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "items",
          "shipping_address",
          "checkout_key",
          "consent"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
