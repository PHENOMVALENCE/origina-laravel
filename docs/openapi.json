{
  "openapi": "3.0.3",
  "info": {
    "title": "ORIGINA Operational API",
    "version": "1.0.0",
    "description": "Laravel platform API. Integer TZS prices. Orders start unpaid. Use a staging database for destructive tests. Bearer tokens expire after eight hours. Swagger UI is administrator-only; API access additionally enforces role and order ownership."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Current environment"
    }
  ],
  "tags": [
    {
      "name": "Identity"
    },
    {
      "name": "Catalogue"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Administration"
    }
  ],
  "paths": {
    "/tokens": {
      "post": {
        "summary": "Issue an eight-hour API token",
        "tags": [
          "Identity"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked token"
          },
          "403": {
            "description": "Insufficient role, inactive or unverified account"
          },
          "404": {
            "description": "Unknown or inaccessible record"
          },
          "422": {
            "description": "Validation or domain lifecycle error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  },
                  "device_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "device_name"
                ]
              }
            }
          }
        }
      }
    },
