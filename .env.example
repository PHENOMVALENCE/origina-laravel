APP_NAME=ORIGINA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

DB_CONNECTION=sqlite
# SQLite defaults to database/database.sqlite when DB_DATABASE is unset.
# For production use mysql and provide DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=ORIGINA
SESSION_SECURE_COOKIE=false

COMMERCE_CHECKOUT_ENABLED=false
COMMERCE_SHIPPING_FEE=0
COMMERCE_PAYMENT_INSTRUCTIONS="Our team will contact you to arrange payment."

# External integrations stay fail-closed until real provider credentials and business approval exist.
PAYMENTS_DRIVER=disabled
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Required before Stripe is considered ready. Set only after confirming how the configured Stripe account expects the order currency's minor units.
STRIPE_MINOR_UNIT_MULTIPLIER=
STRIPE_API_BASE=https://api.stripe.com

SMS_DRIVER=disabled
SMS_FROM=
SMS_ENDPOINT=
SMS_TOKEN=

API_DOCS_ENABLED=false
