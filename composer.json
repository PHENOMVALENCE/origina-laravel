{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "phenomvalence/origina-laravel",
  "type": "project",
  "description": "ORIGINA institutional and commerce platform, implemented with Laravel.",
  "keywords": ["origina", "laravel", "institutional", "commerce"],
  "license": "proprietary",
  "require": {
    "php": ">=8.2.12 <8.3",
    "bacon/bacon-qr-code": "^3.0",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "runtime:check": "@php -r '$v=PHP_VERSION_ID; if ($v < 80212 || $v >= 80300) { fwrite(STDERR, \"ORIGINA requires PHP 8.2.12 or newer within the PHP 8.2 branch. Current: \".PHP_VERSION.PHP_EOL); exit(1); } echo \"PHP runtime compatible: \".PHP_VERSION.PHP_EOL;'",
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ],
    "analyse": "phpstan analyse --memory-limit=1G",
    "lint": "pint",
    "lint:test": "pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2.12"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
